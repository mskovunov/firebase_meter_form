    void saveHeartbeat()
    {
        time_t now = time(nullptr);
        if (now < 1700000000)
            return;

        int wifiStatus = WiFi.status();
        int rssi = WiFi.RSSI();
        bool statusChanged = (lastPersistedWifiStatus != wifiStatus);
        bool persistDue = (lastHeartbeatPersistMs == 0) ||
                          (millis() - lastHeartbeatPersistMs >= HEARTBEAT_PERSIST_MS);

        if (persistDue || statusChanged)
        {
            prefs.begin("diag", false);
            prefs.putULong("hb", (uint32_t)now);
            prefs.putUChar("wifiSt", (uint8_t)wifiStatus);
            prefs.putInt("rssi", rssi);
            prefs.end();

            lastHeartbeatPersistMs = millis();
            lastPersistedWifiStatus = wifiStatus;
            SerialMon.printf("HB persisted wifi=%d rssi=%d\n", wifiStatus, rssi);
        }
        else
        {
            SerialMon.printf("HB wifi=%d rssi=%d (RAM only)\n", wifiStatus, rssi);
        }
    }

    void printBootDiagnostics()
    {
        pinMode(STATUS_LED, OUTPUT);
        pinMode(0, INPUT);

        prefs.begin("diag", false);
        uint32_t boots = prefs.getULong("boots", 0) + 1;
        uint32_t lastHb = prefs.getULong("hb", 0);
        prefs.putULong("boots", boots);
        prefs.end();

        SerialMon.printf("Boot count: %u\n", boots);
        SerialMon.printf("GPIO0=%d (must be 1 for normal boot)\n", digitalRead(0));

        esp_reset_reason_t r = esp_reset_reason();
        SerialMon.printf("Reset reason: %d ", (int)r);
        switch (r)
        {
        case ESP_RST_POWERON:
            SerialMon.println("POWERON");
            break;
        case ESP_RST_EXT:
            SerialMon.println("EXTERNAL");
            break;
        case ESP_RST_SW:
            SerialMon.println("SOFTWARE");
            break;
        case ESP_RST_PANIC:
            SerialMon.println("PANIC");
            break;
        case ESP_RST_INT_WDT:
            SerialMon.println("INT_WDT");
            break;
        case ESP_RST_TASK_WDT:
            SerialMon.println("TASK_WDT");
            break;
        case ESP_RST_WDT:
            SerialMon.println("WDT");
            break;
        case ESP_RST_BROWNOUT:
            SerialMon.println("BROWNOUT");
            break;
        default:
            SerialMon.println();
            break;
        }

        if (lastHb == 0)
        {
            SerialMon.println("Last heartbeat: none (first run after flash)");
            return;
        }

        struct tm t;
        time_t hbTime = (time_t)lastHb;
        localtime_r(&hbTime, &t);
        char buf[32];
        strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", &t);
        SerialMon.printf("Last heartbeat: %s (unix %u)\n", buf, lastHb);
        SerialMon.printf("Heartbeat is persisted every %lu sec; the gap alone does not prove a power loss.\n",
                         HEARTBEAT_PERSIST_MS / 1000UL);
    }

    bool ensureGsmReady()
    {
        if (gsmInited)
            return true;

        SerialMon.println("Init Modem...");
        SerialAT.begin(57600, SERIAL_8N1, MODEM_RX, MODEM_TX);
        wdtDelay(3000);
        esp_task_wdt_reset();

        bool ok = modem.init();
        esp_task_wdt_reset();
        if (!ok)
        {
            SerialMon.println("Modem init failed, trying restart...");
            ok = modem.restart();
            esp_task_wdt_reset();
        }

        if (!ok)
        {
            SerialMon.println("Modem not ready, skip GSM");
            return false;
        }

        httpGsm.setHttpResponseTimeout(HTTP_TIMEOUT_MS);
        gsmInited = true;
        SerialMon.println("Modem ready");
        return true;
    }

