    bool pzemSamplePlausible(double voltage, double current, double power, double energy)
    {
        if (voltage < 0 || voltage > 300.0)
            return false;
        if (current < 0 || current > 100.0)
            return false;
        if (power < 0 || power > 25000.0)
            return false;
        if (energy < 0 || energy > 1000000.0)
            return false;
        if (voltage >= 80.0 && current >= 0.05 && power > voltage * current * 1.5 + 30.0)
            return false;
        if (hasAcceptedPzemEnergy)
        {
            double delta = energy - lastAcceptedPzemEnergy;
            if (delta > 200.0)
                return false;
            if (delta < -1.0 && energy > 1.0)
                return false;
        }
        return true;
    }

    void tickLed()
    {
        digitalWrite(STATUS_LED, (millis() / 500) % 2);
    }

    void wdtDelay(unsigned long ms)
    {
        unsigned long start = millis();
        while (millis() - start < ms)
        {
            tickLed();
            esp_task_wdt_reset();
            delay(50);
        }
    }

