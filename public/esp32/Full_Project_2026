    void loop()
    {
        esp_task_wdt_reset();
        tickLed();
        maintainWifi();

        if (millis() - lastHeartbeatMs >= HEARTBEAT_LOG_MS)
        {
            lastHeartbeatMs = millis();
            saveHeartbeat();
        }

        int rawMains = digitalRead(MAINS_PIN);
        if (rawMains != lastStableMains)
        {
            if (mainsChangeMs == 0)
                mainsChangeMs = millis();
            else if (millis() - mainsChangeMs >= 1500)
            {
                lastStableMains = rawMains;
                mainsChangeMs = 0;
                isPowerOn = (rawMains == HIGH);

                float currentVolt = 0.0;
                int bat = getBatteryPercentage(isPowerOn, currentVolt);

                if (isPowerOn)
                {
                    SerialMon.println("EVENT: Power Restored");
                    sendSmart(1, "PowerRestored", bat, currentVolt);
                }
                else
                {
                    SerialMon.println("EVENT: Power Lost");
                    sendSmart(0, "PowerLost", bat, currentVolt);
                }
            }
        }
        else
        {
            mainsChangeMs = 0;
        }

        if (ENABLE_WIFI && WiFi.status() == WL_CONNECTED && Firebase.ready() && (millis() - sendPzemPrevMillis > sendIntervalPzem))
        {
            sendPzemPrevMillis = millis();
            esp_task_wdt_reset();

            float voltage = pzem.voltage();
            esp_task_wdt_reset();
            float current = pzem.current();
            esp_task_wdt_reset();
            float power = pzem.power();
            esp_task_wdt_reset();
            float energy = pzem.energy();
            esp_task_wdt_reset();

            if (isnan(voltage) || voltage < 0)
                voltage = 0.0;
            if (isnan(current) || current < 0)
                current = 0.0;
            if (isnan(power) || power < 0)
                power = 0.0;
            if (isnan(energy) || energy < 0)
                energy = 0.0;

            double cleanVoltage = round(voltage * 10) / 10.0;
            double cleanCurrent = round(current * 1000) / 1000.0;
            double cleanPower = round(power * 10) / 10.0;
            double cleanEnergy = round(energy * 1000) / 1000.0;

            if (!pzemSamplePlausible(cleanVoltage, cleanCurrent, cleanPower, cleanEnergy))
            {
                SerialMon.printf("PZEM rejected: %.1f V, %.3f A, %.1f W, %.3f kWh\n",
                                 cleanVoltage, cleanCurrent, cleanPower, cleanEnergy);
            }
            else
            {
            lastAcceptedPzemEnergy = cleanEnergy;
            hasAcceptedPzemEnergy = true;

            String timeStr = getCurrentTime();
            SerialMon.println("--------------------------------------");
            SerialMon.printf("[%s] PZEM READINGS (Int: %ds):\n", timeStr.c_str(), sendIntervalPzem / 1000);
            SerialMon.printf("Voltage: %.1f V\n", cleanVoltage);
            SerialMon.printf("Current: %.3f A\n", cleanCurrent);
            SerialMon.printf("Power:   %.1f W\n", cleanPower);
            SerialMon.printf("Energy:  %.3f kWh\n", cleanEnergy);
            SerialMon.println("Sending to Firebase...");
            SerialMon.println("--------------------------------------");

            FirebaseJson content;
            content.set("fields/voltage/doubleValue", cleanVoltage);
            content.set("fields/current/doubleValue", cleanCurrent);
            content.set("fields/power/doubleValue", cleanPower);
            content.set("fields/energy/doubleValue", cleanEnergy);
            content.set("fields/created_at/stringValue", timeStr);
            content.set("fields/timestamp_unix/integerValue", (int)time(nullptr));

            if (writeFirestore("meter_readings", content))
                SerialMon.println(">>> FIREBASE SUCCESS.");
            else
                SerialMon.printf(">>> FIREBASE ERROR: %s\n", fbdo.errorReason().c_str());
            }
        }

        if (millis() - lastKeepAlive > sendInterval)
        {
            if (millis() - sendPzemPrevMillis >= 5000)
            {
                float currentVolt = 0.0;
                int bat = getBatteryPercentage(isPowerOn, currentVolt);

                SerialMon.print("Routine Check (Interval: ");
                SerialMon.print(sendInterval / 1000);
                SerialMon.println("s)...");

                if (sendSmart(isPowerOn ? 1 : 0, "RoutineCheck", bat, currentVolt))
                    lastKeepAlive = millis();
                else
                    SerialMon.println("Routine send failed — retry on next interval");
            }
        }
        delay(100);
    }

    bool sendSmart(int val, String deviceStatus, int batLevel, float voltage)
    {
        bool sent = false;

        if (ENABLE_WIFI)
        {
            if (WiFi.status() != WL_CONNECTED)
            {
                SerialMon.print("Wi-Fi reconnecting...");
                WiFi.reconnect();
                for (int i = 0; i < 50; i++)
                {
                    if (WiFi.status() == WL_CONNECTED)
                        break;
                    SerialMon.print(".");
                    wdtDelay(100);
                }
                SerialMon.println();
            }

            if (WiFi.status() == WL_CONNECTED)
            {
                HTTPClient http;

                String url = "https://script.google.com/macros/s/" + GAS_SCRIPT_ID + "/exec";
                url += "?val=" + String(val);
                url += "&device=" + deviceStatus;
                url += "&bat=" + String(batLevel);
                url += "&volt=" + String(voltage, 2);

                http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
                http.setTimeout(HTTP_TIMEOUT_MS);
                http.setConnectTimeout(10000);
                http.begin(url);

                SerialMon.print("[Wi-Fi Direct] Sending... ");
                tickLed();
                esp_task_wdt_reset();
                int httpCode = http.GET();
                tickLed();
                esp_task_wdt_reset();

                if (httpCode == 200)
                {
                    String payload = http.getString();
                    SerialMon.print("GAS Config: ");
                    SerialMon.println(payload);

                    int idx1 = payload.indexOf(',');
                    int idx2 = payload.indexOf(',', idx1 + 1);
                    int idx3 = payload.indexOf(',', idx2 + 1);

                    if (idx3 > 0)
                    {
                        String sBat = payload.substring(0, idx1);
                        String sPzem = payload.substring(idx1 + 1, idx2);
                        String sWifi = payload.substring(idx2 + 1, idx3);
                        String sGsm = payload.substring(idx3 + 1);

                        int newBat = sBat.toInt();
                        int newPzem = sPzem.toInt();

                        if (newBat >= 10 && newBat <= 3600)
                            sendInterval = newBat * 1000;
                        if (newPzem >= 10 && newPzem <= 3600)
                            sendIntervalPzem = newPzem * 1000;

                        bool newWifiState = (sWifi.toInt() == 1);
                        bool newGsmState = (sGsm.toInt() == 1);
                        bool flagsChanged = (ENABLE_WIFI != newWifiState) || (ENABLE_GSM != newGsmState);

                        if (ENABLE_WIFI != newWifiState)
                        {
                            ENABLE_WIFI = newWifiState;
                            SerialMon.print("!!! WIFI Config Changed: ");
                            SerialMon.println(ENABLE_WIFI ? "ON" : "OFF");
                        }
                        if (ENABLE_GSM != newGsmState)
                        {
                            ENABLE_GSM = newGsmState;
                            SerialMon.print("!!! GSM Config Changed: ");
                            SerialMon.println(ENABLE_GSM ? "ON" : "OFF");
                        }

                        if (flagsChanged)
                            persistFlags();
                        if (flagsChanged && ENABLE_GSM)
                            SerialMon.println("GSM ON saved. Modem will start on next boot or first GSM fallback.");
                    }
                    else
                    {
                        int newSec = payload.toInt();
                        if (newSec >= 10 && newSec <= 3600)
                            sendInterval = newSec * 1000;
                    }

                    sent = true;
                }
                else
                {
                    SerialMon.print("Error: ");
                    SerialMon.println(httpCode);
                }
                http.end();
            }
        }
        else
        {
            SerialMon.println("Wi-Fi is DISABLED by Config.");
        }

        if (!sent && ENABLE_GSM)
        {
            SerialMon.println("[GSM] Switching to Backup (PushingBox)...");

            if (!ensureGsmReady())
                return false;

            if (!modem.isGprsConnected())
            {
                SerialMon.print("[GSM] Connecting GPRS... ");
                esp_task_wdt_reset();
                if (!modem.gprsConnect(apn, user, pass))
                {
                    SerialMon.println("FAIL. Skip restart to avoid hang.");
                    esp_task_wdt_reset();
                    return false;
                }
                SerialMon.println("OK");
                esp_task_wdt_reset();
            }

            String path = "/pushingbox?devid=" + String(DEVID) +
                        "&val=" + String(val) +
                        "&device=" + deviceStatus +
                        "&bat=" + String(batLevel) +
                        "&volt=" + String(voltage, 2);

            SerialMon.print("[GSM] Sending... ");
            httpGsm.stop();
            esp_task_wdt_reset();
            int err = httpGsm.get(path);
            esp_task_wdt_reset();

            if (err == 0)
            {
                SerialMon.println("Success! (Backup used)");
                httpGsm.responseBody();
                sent = true;
            }
            else
            {
                SerialMon.println("Error via GSM: " + String(err));
            }
        }

        return sent;
    }

    int getBatteryPercentage(bool charging, float &outVoltage)
    {
        long sum = 0;
        for (int i = 0; i < 50; i++)
        {
            sum += analogRead(BAT_PIN);
            delay(2);
        }
        float average = sum / 50.0;

        if (charging)
            outVoltage = (average / 4095.0) * 3.3 * 2.12;
        else
            outVoltage = (average / 4095.0) * 3.3 * 2.34;

        int percentage = 0;
        float v = outVoltage;

        if (v >= 4.15)
            percentage = 100;
        else if (v >= 4.05)
            percentage = 95;
        else if (v >= 3.95)
            percentage = 85;
        else if (v >= 3.85)
            percentage = 75;
        else if (v >= 3.75)
            percentage = 60;
        else if (v >= 3.65)
            percentage = 40;
        else if (v >= 3.50)
            percentage = 15;
        else
            percentage = 0;

        if (charging && percentage < 100 && v > 3.9)
            percentage += 2;

        SerialMon.print("Bat: ");
        SerialMon.print(outVoltage);
        SerialMon.print("V | ");
        SerialMon.print(percentage);
        SerialMon.println("%");
        return percentage;
    }

    String getCurrentTime()
    {
        struct tm timeinfo;
        if (!getLocalTime(&timeinfo))
            return "TimeError";
        char timeStringBuff[50];
        strftime(timeStringBuff, sizeof(timeStringBuff), "%Y-%m-%d %H:%M:%S", &timeinfo);
        return String(timeStringBuff);
    }

    void sendLog(String message)
    {
        if (ENABLE_WIFI && WiFi.status() == WL_CONNECTED && Firebase.ready())
        {
            SerialMon.println("Logging to Firestore...");

            FirebaseJson content;
            content.set("fields/message/stringValue", message);
            content.set("fields/created_at/stringValue", getCurrentTime());

            String reason = "Unknown";
            esp_reset_reason_t r = esp_reset_reason();
            switch (r)
            {
            case ESP_RST_POWERON:
                reason = "Power ON (Живлення)";
                break;
            case ESP_RST_EXT:
                reason = "External Reset (Кнопка)";
                break;
            case ESP_RST_SW:
                reason = "Software Reset (Код)";
                break;
            case ESP_RST_PANIC:
                reason = "Crash/Panic (Помилка)";
                break;
            case ESP_RST_INT_WDT:
                reason = "Int. Watchdog";
                break;
            case ESP_RST_TASK_WDT:
                reason = "Task Watchdog (Зависання)";
                break;
            case ESP_RST_WDT:
                reason = "Other Watchdog";
                break;
            case ESP_RST_BROWNOUT:
                reason = "Brownout (Просадка напруги)";
                break;
            default:
                reason = String(r);
                break;
            }
            content.set("fields/reason/stringValue", reason);

            if (writeFirestore("system_logs", content))
                SerialMon.println("Log sent!");
            else
                SerialMon.println("Log failed.");
        }
    }
